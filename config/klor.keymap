//                               █         █    █            ▄▄▄▀▀▀▀▀▀▄▄▄        █▀▀▀▀▀▀▀▀▀▀█
//                               █        █     █          ▄▀            ▀▄      █          █
//                               █       █      █        ▄▀                ▀▄    █          █
//                               █      █       █        █                  █    █          █
//                               █     █        █       █                    █   █          █
//                               █    █         █       █                    █   █▄▄▄▄▄▄▄▄▄▄█
//                               █   █ █        █       █                    █   █      █
//                               █  █   █       █        █                  █    █       █
//                               █ █     █      █        ▀▄                ▄▀    █        █
//                               ██       █     █          ▀▄            ▄▀      █         █
//                               █         █    █▄▄▄▄▄▄▄▄    ▀▀▀▄▄▄▄▄▄▀▀▀        █          █
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3
#define EXTRA  4

/ {
    behaviors {
        // Tap-Dance для клавиши M: 1 нажатие = M, 2 нажатия = Ъ (])

        td_m: tap_dance_m {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp M>, <&kp RBRC>;
        };

        // Макрос для смены языка (Win+Space)

        lang_sw: lang_switch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Комбо Q+E (позиции 0 и 2) только для базового слоя

        combo_lang {
            timeout-ms = <100>;
            key-positions = <0 2>;
            layers = <0>;
            bindings = <&lang_sw>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        // ==========================================
        // Layer 0 (BASE)
        // ==========================================

        base_layer {
            label = "BASE";
            bindings = <
               &kp Q  &kp W  &kp E     &kp R     &kp T                             &kp Y      &kp U       &kp I      &kp O    &kp P
&kp LSHFT      &kp A  &kp S  &kp D     &kp F     &kp G                             &kp H      &kp J       &kp K      &kp L    &kp SEMICOLON  &kp LEFT_BRACKET
&mt LCTRL ESC  &kp Z  &kp X  &kp C     &kp V     &kp B      &kp C_MUTE   &kp C_PP  &kp N      &td_m       &kp COMMA  &kp DOT  &kp SLASH      &kp SQT
                             &kp LALT  &kp LGUI  &lt 2 TAB  &lt 1 SPACE  &mo 2     &kp ENTER  &lt 3 BSPC  &kp DEL
            >;

            sensor-bindings = <&inc_dec_cp C_VOL_UP C_VOL_DN &inc_dec_cp C_PREV C_NEXT>;
        };

        // ==========================================
        // Layer 1 (LOWER) - Символы
        // ==========================================

        lower_layer {
            label = "LOWER";
            bindings = <
           &kp NUMBER_8           &kp LS(NUMBER_7)  &kp LS(NUMBER_8)  &kp LS(NUMBER_9)  &kp LESS_THAN                  &kp UP     &kp DOWN   &kp LEFT   &kp RIGHT      &kp DEL
&kp PLUS   &kp RIGHT_PARENTHESIS  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)  &kp LS(NUMBER_6)  &kp DOT                        &kp MINUS  &kp RSHFT  &kp RCTRL  &kp RIGHT_ALT  &kp RGUI   &none
&kp UNDER  &kp PIPE               &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp SLASH      &trans  &trans  &none      &none      &kp COMMA  &kp DOT        &kp SLASH  &kp BSLH
                                                    &trans            &trans            &trans         &trans  &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_cp C_VOL_UP C_VOL_DN &inc_dec_cp C_PREV C_NEXT>;
        };

        // ==========================================
        // Layer 2 (RAISE) - Numpad
        // ==========================================

        raise_layer {
            label = "RAISE";
            bindings = <
           &kp LSHFT  &kp N7        &kp N8        &kp N9        &kp RPAR                     &kp KP_N7       &kp UP_ARROW  &kp KP_N9        &kp KP_PLUS      &kp KP_MINUS
&kp LSHFT  &kp N0     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EXCL                     &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp KP_MULTIPLY  &kp KP_DIVIDE  &kp LSHFT
&kp DLLR   &kp EXCL   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT   &trans  &kp KP_N1  &kp KP_N2       &kp KP_N3     &kp KP_N0        &kp KP_DOT       &trans         &trans
                                    &trans        &trans        &trans    &trans  &trans     &trans          &trans
            >;

            sensor-bindings = <&inc_dec_cp C_VOL_UP C_VOL_DN &inc_dec_cp C_PREV C_NEXT>;
        };

        // ==========================================
        // Layer 3 (ADJUST) - F-клавиши
        // ==========================================

        adjust_layer {
            label = "ADJUST";
            bindings = <
           &kp F12  &kp F7  &kp F8  &kp F9  &kp PSCRN                        &trans  &trans  &trans     &trans     &trans
&kp CLCK   &kp F11  &kp F4  &kp F5  &kp F6  &kp SLCK                         &trans  &trans  &kp RSHFT  &kp RCTRL  &kp LALT  &kp RGUI
&kp LCTRL  &kp F10  &kp F1  &kp F2  &kp F3  &kp PAUSE_BREAK  &trans  &trans  &trans  &trans  &trans     &trans     &trans    &mo 4
                            &trans  &trans  &trans           &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_cp C_VOL_UP C_VOL_DN &inc_dec_cp C_PREV C_NEXT>;
        };

        // ==========================================
        // Layer 4 (EXTRA) - Служебный слой
        // ==========================================

        extra_layer {
            label = "EXTRA";
            bindings = <
           &bt BT_CLR  &trans      &trans      &trans      &ext_power EP_TOG                  &trans  &trans  &trans  &trans  &none
&none      &none       &bt BT_PRV  &bt BT_PRV  &bt BT_NXT  &trans                             &trans  &trans  &trans  &none   &trans  &trans
&kp LCTRL  &none       &bt BT_NXT  &trans      &trans      &trans             &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans
                                   &bt BT_CLR  &trans      &trans             &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_cp C_VOL_UP C_VOL_DN &inc_dec_cp C_PREV C_NEXT>;
        };
    };
};
