#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,matrix-transform = &default_transform;
        zmk,display = &st7789;
    };

    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>; 
        rows = <4>;

        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,5) RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
        >;
    };
};

/* ==========================================================================
 * РУЧНОЕ ОБЪЯВЛЕНИЕ PINCTRL ДЛЯ SPI ШИНЫ XIAO BLE (Исправление ошибки ZMK v0.3)
 * ========================================================================== */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            /* Подключаем MOSI -> D9 (P0.06), SCK -> D10 (P0.13) */
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_SCK, 0, 13)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 6)>,
                    <NRF_PSEL(SPIM_SCK, 0, 13)>;
            low-power-enable;
        };
    };
};

/* Напрямую настраиваем аппаратный контроллер spi0 по требованиям Zephyr OS */
&spi0 {
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";

    // Аппаратный CS (Chip Select) экрана вешаем на пин D7 (P0.29)
    cs-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <24000000>;

        /* Управляющие пины экрана */
        cmd-data-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;   /* D1 (P0.03) */
        reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;      /* D0 (P0.02) */

        /* Реальное физическое разрешение и сдвиг экрана Waveshare 1.69" */
        width = <240>;
        height = <280>;
        x-offset = <0>;
        y-offset = <20>; // Центрирует интерфейс YADS внутри закругленной матрицы

        /* Допустимые для драйвера Zephyr параметры инициализации */
        vcom = <0x19>;
        gctrl = <0x35>;
        vrhs = <0x12>;
        vdvs = <0x20>;
        mdac = <0x00>;
        lcm = <0x2c>;
        colmod = <0x05>;

        /* Обязательные параметры таймингов и инициализации для Zephyr v3.5 */
        porch-param = [0c 0c 00 33 33];
        cmd2en-param = [5a 69 02 01];
        pwctrl1-param = [a4 a1];
        pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
        nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
        ram-param = [00 f0 00 f0];

        /* Критически важные свойства для компиляции в ветке ZMK v0.3 */
        rgb-param = [cd 08 14];
        mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
    };
};
