#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,physical-layout = &physical_layout0;
    };

    mock_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <>;
    };

    /* Заглушки энкодеров */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        status = "disabled";
    };

    /* Обязательный узел для подписки донгла на события энкодеров */
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        status = "okay";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        status = "okay";
        display-name = "Klor Dongle";

        kscan = <&mock_kscan>;
        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  201   55  (-400)   251   105>
            , <&key_physical_attrs 100 100  400  364       0     0     0>
            , <&key_physical_attrs 100 100  703  491 (-4500)   753   541>
            , <&key_physical_attrs 100 100 1000  491    4500  1050   541>
            , <&key_physical_attrs 100 100 1303  364       0     0     0>
            , <&key_physical_attrs 100 100 1503   55     400  1553   105>
            , <&key_physical_attrs 100 100    0  222 (-1000)    50   272>
            , <&key_physical_attrs 100 100  315  100       0     0     0>
            , <&key_physical_attrs 100 100  511  379    1500   561   429>
            , <&key_physical_attrs 100 100 1192  379 (-1500)  1242   429>
            , <&key_physical_attrs 100 100 1388  100       0     0     0>
            , <&key_physical_attrs 100 100 1703  222    1000  1753   272>
            , <&key_physical_attrs 100 100  215  255  (-400)   265   305>
            , <&key_physical_attrs 100 100 1489  255     400  1539   305>
            , <&key_physical_attrs 100 100  515  164       0     0     0>
            , <&key_physical_attrs 100 100 1188  164       0     0     0>
            , <&key_physical_attrs 100 100   18  320 (-1000)    68   370>
            , <&key_physical_attrs 100 100  650  286       0     0     0>
            , <&key_physical_attrs 100 100 1054  286       0     0     0>
            , <&key_physical_attrs 100 100 1686  320    1000  1736   370>
            , <&key_physical_attrs 100 100  208  155  (-400)   258   205>
            , <&key_physical_attrs 100 100  515   63       0     0     0>
            , <&key_physical_attrs 100 100  515  264       0     0     0>
            , <&key_physical_attrs 100 100 1188  264       0     0     0>
            , <&key_physical_attrs 100 100 1188   63       0     0     0>
            , <&key_physical_attrs 100 100 1496  155     400  1546   205>
            , <&key_physical_attrs 100 100  315    0       0     0     0>
            , <&key_physical_attrs 100 100 1388    0       0     0     0>
            , <&key_physical_attrs 100 100  121  329 (-1000)   171   379>
            , <&key_physical_attrs 100 100  614  422    3000   664   472>
            , <&key_physical_attrs 100 100 1089  422 (-3000)  1139   472>
            , <&key_physical_attrs 100 100 1583  329    1000  1633   379>
            , <&key_physical_attrs 100 100   86  131 (-1000)   136   181>
            , <&key_physical_attrs 100 100  416  148       0     0     0>
            , <&key_physical_attrs 100 100  416  248       0     0     0>
            , <&key_physical_attrs 100 100 1288  248       0     0     0>
            , <&key_physical_attrs 100 100 1288  148       0     0     0>
            , <&key_physical_attrs 100 100 1618  131    1000  1668   181>
            , <&key_physical_attrs 100 100  103  230 (-1000)   153   280>
            , <&key_physical_attrs 100 100  315  201       0     0     0>
            , <&key_physical_attrs 100 100 1388  201       0     0     0>
            , <&key_physical_attrs 100 100 1600  230    1000  1650   280>
            , <&key_physical_attrs 100 100  416   47       0     0     0>
            , <&key_physical_attrs 100 100 1288   47       0     0     0>
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
        map = <
RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(3,5) RC(3,6) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                            RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,7) RC(3,8) RC(3,9) RC(3,10)
        >;
    };
};
